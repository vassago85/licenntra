#--------------------------------------------------------------------
# Licentra production .env — copy to /opt/licentra/.env and fill in.
# Secrets (DB_PASSWORD, APP_KEY, mail creds) must NOT be committed.
#--------------------------------------------------------------------

# Required for `docker compose` to pick the prod file by default on the host.
COMPOSE_FILE=docker-compose.prod.yml

# Entrypoint behaviour. Both default to true. Flip to false if you ever
# want to manage migrations / seeding manually (e.g. a staging deploy).
APP_RUN_MIGRATIONS_ON_BOOT=true
# On first boot (empty users table) the entrypoint runs DemoSeeder so the
# demo personas exist. On every subsequent boot this is a no-op.
APP_SEED_ON_BOOT=true

APP_NAME=Licentra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://licentra.charsleydigital.co.za
APP_TIMEZONE=Africa/Johannesburg

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database — matches docker-compose.prod.yml defaults
DB_CONNECTION=pgsql
DB_HOST=licentra-pgsql
DB_PORT=5432
DB_DATABASE=licentra
DB_USERNAME=licentra
DB_PASSWORD=change-me

# Redis — queue, cache, sessions
REDIS_HOST=licentra-redis
REDIS_PORT=6379
REDIS_CLIENT=predis

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Cookies are set only over HTTPS (Nginx Proxy Manager terminates TLS
# on 443 and forwards to 127.0.0.1:8089). Pair with APP_URL=https://...
# so Laravel knows to issue secure cookies and emit https URLs.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Filesystem — documents land on /mnt/data/licentra/storage/app/private
# via the bind-mount declared in docker-compose.prod.yml.
FILESYSTEM_DISK=local

# Mail — Mailgun (populate before go-live; Site Settings UI can
# override at runtime via settings table).
MAIL_MAILER=mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAIL_FROM_ADDRESS=no-reply@licentra.charsleydigital.co.za
MAIL_FROM_NAME="${APP_NAME}"

# S3 (unused today — documents disk is local — but kept for future
# migration to Cloudflare R2 / MinIO / AWS without redeploy).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# Horizon dashboard — restrict in app/Providers/HorizonServiceProvider.php
# by email allowlist before exposing publicly.
HORIZON_PATH=horizon

# ClamAV is dev-only right now; keep disabled in prod unless we add a
# container to docker-compose.prod.yml.
CLAMAV_ENABLED=false

# Default: entrypoint runs `migrate --force` on `app` container boot.
# Set to false during risky rollouts, then run manually.
APP_RUN_MIGRATIONS_ON_BOOT=true

# Demo mode — exposes the seeded user list (super admin / reviewer /
# finance / auditor / client admin / client user, password = "password")
# on the login page so visitors can try each persona. SET TO FALSE for
# a real licensing-company tenant; TRUE only for the public demo.
DEMO_MODE_CREDENTIALS=true
